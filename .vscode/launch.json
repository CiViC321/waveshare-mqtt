{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Waveshare MQTT",
            "type": "debugpy",
            "request": "launch",
            "module": "waveshare_mqtt.main",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Attach to SolarPi debugpy",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "solarpi.localnet",
                "port": 5678
            },
            "pathMappings": [
                {
                "localRoot": "${workspaceFolder}",
                "remoteRoot": "/home/petri/code/waveshare-mqtt"
                }
            ],
            "justMyCode": true
            }
    ]
}
