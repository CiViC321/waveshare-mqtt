# Serial Modbus RTU
MODBUS_PORT=COM3
MODBUS_SLAVE_ID=1
MODBUS_BAUDRATE=9600
MODBUS_BYTESIZE=8
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_TIMEOUT=1.0
MODBUS_RELAY_START_REGISTER=0
MODBUS_INPUT_START_REGISTER=0

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=waveshare-relay-1
MQTT_BASE_TOPIC=waveshare
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_POLL_INTERVAL=5.0
LOG_LEVEL=INFO
